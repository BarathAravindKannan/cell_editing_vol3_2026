@namespace Syncfusion.Blazor.Grids.Internal
@using System.Collections.Specialized;
@using System.Threading;
@using System.Text.Json.Serialization;
@typeparam TContent
@implements IRenderer
@implements IDomVirtualContent
@implements IDisposable

@*
    DOM Virtualization Renderer
    
    Used when: EnableDomVirtualization=true
    
    Renders only visible rows and provides custom scrollbar to handle browser's 
    max scroll height limit (~32M px). Enables rendering 100M+ records smoothly.
    
    CORRECT DOM Structure (matching EJ2 Syncfusion):
    
    <div class="e-gridcontent" style="...">
        <!-- Content area with overflow scroll -->
        <div class="e-content e-yscroll" style="...">
            <!-- Table with virtualized rows -->
            <table><!-- rows --></table>
        </div>
        
        <!-- Custom vertical scrollbar (SIBLING to content, not nested) -->
        <div class="e-virtual-vertical-scrollbar e-dom-virtual-scrollbar" style="...">
            <div class="e-virtual-vertical-track e-dom-virtual-vertical-track"></div>
        </div>
    </div>
*@

<!-- GRIDCONTENT CONTAINER (full structure for DOM virtualization) -->
<div class="@GetGridContentClass()" style="@GetGridContentStyle()" @onclick="@(Parent?.EditModule != null ? Parent.EditModule.HandleContentClickEdit : null)">
    
    <!-- CONTENT AREA (e-content wrapper) -->
    <div class="@GetContentClassName()" 
         @ref="ContentElement"
         aria-busy="false"
         style="@GetContentStyle()">
        
        <!-- VIRTUAL TABLE WRAPPER -->
        <div class="e-virtualtable e-dom-virtualtable" data-sf-style="@GetStyles()">
            
            <!-- TABLE CONTAINER -->
            <table class="e-table" data-sf-style="@(Parent!.GetTableStyles())" role="presentation" id="@($"{Parent.ID}_content_table")">
                <WidthController ID="domvirtualcontent" TContent="TContent" Columns="@Parent.VirtualScrollModule?.GetVirtualColumns()"></WidthController>
                <tbody role="rowgroup">
                    @if (Parent.EditSettings!.AllowAdding && Parent.EditSettings.ShowAddNewRow && Parent.EditSettings.NewRowPosition == NewRowPosition.Top && Parent.FrozenRows == 0 && !Parent.EnableInfiniteScrolling)
                    {
                        <GridAddNewRow TRow="TContent"></GridAddNewRow>
                    }
                    <!-- Render only RenderedRows (visible + buffer); row objects are created on demand per window -->
                    @if (RenderedRows != null && RenderedRows.Count > 0)
                    {
                        @foreach (Row<object> Row in RenderedRows)
                        {
                            var rowParameters = new GridRowParameters()
                            {
                                Row = Row
                            };
                            if (Row.IsExpand && Row.IsDetailRow)
                            {
                                <GridDetailRow TRow="TContent" RowParameters="@rowParameters" @key="GetRowKey(Row)"></GridDetailRow>
                            }
                            else if (Row.Visible)
                            {
                                if (IsGroupMode ? ReferenceEquals(Row, RenderedRows[RenderedRows.Count - 1]) && RenderedEndIndex == ScrollRowCount : Row.Index == ScrollRowCount - 1)
                                {
                                    rowParameters.IsLastRow = true;
                                }
                                <GridRow TRow="TContent" RowParameters="@rowParameters" @key="GetRowKey(Row)"></GridRow>
                            }
                        }
                    }
                    else
                    {
                        <tr role="row" class="e-emptyrow">
                            <td colspan="@GetVisibleColumnsCount()" style="text-align: center; padding: 20px;">
                                @if (Parent.IsDataLoaded)
                                {
                                    <span>No records to display</span>
                                }
                                else
                                {
                                    <span>Loading...</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
        </div>
        
        <!-- VIRTUAL TRACK (inside e-content, sibling to e-virtualtable) -->
        <div class="e-virtualtrack e-dom-virtualtrack" data-sf-style="@GetVirtualTrackStyles()"></div>
        
    </div>
    
    <!-- CUSTOM VERTICAL SCROLLBAR (SIBLING to e-content, NOT nested inside) -->
    <div class="e-virtual-vertical-scrollbar e-dom-virtual-scrollbar"
         @ref="ScrollbarElement"
         style="position: absolute;
                 right: 0;
                 top: 0;
                 height: 100%;
                 width: 16px;
                 overflow-x: hidden;
                 overflow-y: scroll;
                 z-index: 100;">
        
        <!-- Track element (sets scrollable height) -->
        <div class="e-virtual-vertical-track e-dom-virtual-vertical-track"
             @ref="ScrollbarTrackElement"
             style="@GetScrollbarTrackStyles()">
        </div>
    </div>
</div>

@code {
    #region Public Properties

    [Parameter]
    public GridContentParameters? ContentParameters { get; set; }

    #endregion

    #region Cascading Parameters

    [CascadingParameter]
    SfGrid<TContent>? Parent { get; set; }

    [CascadingParameter]
    [JsonIgnore]
    BaseComponent? BaseParent { get; set; }

    #endregion

    #region Private Fields

    private ElementReference ContentElement { get; set; }
    private ElementReference ScrollbarElement { get; set; }
    private ElementReference ScrollbarTrackElement { get; set; }

    private List<Row<object>> RenderedRows { get; set; } = new();

    // IRenderer contract. Data is the raw source; Rows exposes only the rows currently created for the window.
    public IEnumerable<object> Data
    {
        get => _items?.Cast<object>() ?? System.Linq.Enumerable.Empty<object>();
        set { }
    }

    public List<Row<object>> Rows
    {
        get => RenderedRows;
        set { }
    }

    // Raw records (indexable). Row<object> objects are created on demand only for the rendered window.
    private System.Collections.IList? _items;
    private object? _sourceReference;
    private readonly Dictionary<int, Row<object>> _rowCache = new();
    private int TotalCount => Parent?.TotalItemCount ?? 0;

    // Grouped data is windowed over the visible group entries (captions, data, footers); row virtualization's record cache is not used then.
    private bool IsGroupMode => Parent?.DomVirtualModule?.IsGroupMode == true;
    private bool IsRowVirtual => Parent != null && Parent.EnableVirtualization && Parent.VirtualScrollModule != null && !IsGroupMode;
    private object? _generatedDataRef;
    private int _lastTotal = -1;
    private bool _fetching;
    private bool _refreshAfterFetch;
    private bool _windowChanged;
    private bool _observingDetails;
    private int _firstVisibleIndex;
    private int _visibleRowCount;

    public int ScrollRowCount
    {
        get
        {
            if (IsGroupMode)
            {
                return Parent!.DomVirtualModule!.GroupEntryCount;
            }
            if (Parent == null || !Parent.AllowPaging || IsRowVirtual || Parent.PageSettings == null)
            {
                return TotalCount;
            }
            int pageSize = Parent.PageSettings.PageSize;
            int rowsOnPage = TotalCount - ((Parent.PageSettings.CurrentPage - 1) * pageSize);
            return Math.Max(0, Math.Min(pageSize, rowsOnPage));
        }
    }
    public int CurrentScrollTop { get; set; } = 0;
    public int ViewportHeight => GetResolvedViewportHeight();
    private int AddedBottomCount => Parent?.DomVirtualModule?.AddedBottomCount ?? 0;
    // The unsaved bottom add form takes one row of scroll space on top of the data rows.
    private int TrackRowCount => ScrollRowCount + AddedBottomCount;
    // Uniform rows plus the heights of the expanded detail rows (zero without a DetailTemplate expansion).
    public long TotalDataHeight => ((long)TrackRowCount * RowHeight) + (Parent?.DomVirtualModule?.DetailTotalHeight ?? 0);
    public int RowHeight => Parent?.RowHeight > 0 ? (int)Parent.RowHeight : 30;
    private double ScrollAmplificationFactor { get; set; } = 1.0;
    public int BrowserMaxScrollHeight { get; set; } = 32767000;

    private long CurrentRowOffset { get; set; }
    private long TranslateY { get; set; }
    private int CurrentStartIndex { get; set; }
    private int RenderedEndIndex { get; set; }

    #endregion

    #region Lifecycle

    protected override void OnInitialized()
    {
        // Task 01: Register event listener for when RHeight is updated from SfGrid.Lifecycle
        // Follows same pattern as GridVirtualContent.razor
        // Wrap method in Action<object> delegate to match EventAggregator.Add signature
        Parent?.EventAggregator?.Add("DomVirtualComponentUpdate", new Action<object>(DomVirtualComponentUpdate));
        Parent?.EventAggregator?.AddAsync("DomVirtualScroll", HandleDomVirtualScroll);
        Parent?.EventAggregator?.AddAsync("DomVirtualMaxHeightChanged", HandleDomVirtualMaxHeightChanged);
        if (Parent?.DomVirtualModule != null)
        {
            Parent.DomVirtualModule.Content = this;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Parent == null) return;
        
        await UpdateRenderedRows();
        await base.OnInitializedAsync();
    }

    private int GetResolvedViewportHeight()
    {
        string? height = Parent?.Height;
        if (!string.IsNullOrEmpty(height))
        {
            string numeric = height.EndsWith("px", StringComparison.OrdinalIgnoreCase) ? height.Substring(0, height.Length - 2) : height;
            if (double.TryParse(numeric, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double value) && value > 0)
            {
                return (int)value;
            }
        }
        return 300;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Parent == null || ContentParameters == null) return;

        // Reload only when the data source instance or its size changed (no per-item comparison of the whole dataset).
        IEnumerable<object>? source = ContentParameters.Data;
        bool grouped = Parent.DomVirtualModule != null && DomVirtualHandler<TContent>.IsGroupedSource(Parent, source);
        bool changed = grouped || IsGroupMode
            ? !ReferenceEquals(source, _sourceReference) || grouped != IsGroupMode
            : IsRowVirtual
            ? HasVirtualSourceChanged()
            : !ReferenceEquals(source, _sourceReference)
                || (_items != null && source is System.Collections.ICollection collection && collection.Count != _items.Count);
        if (changed)
        {
            _sourceReference = source;
            await GenerateRows();
        }

        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Parent != null && ContentElement.Context != null)
        {
            await UpdateRenderedRows();
        }
        else if (_windowChanged)
        {
            _windowChanged = false;
            DomVirtualHandler<TContent>? domVirtual = Parent?.DomVirtualModule;
            if (domVirtual?.PendingInputValues != null && Parent!.IsEdit && Parent.EditModule?.EditedRow != null && RenderedRows.Contains(Parent.EditModule.EditedRow))
            {
                await domVirtual.ApplyPendingInputValuesAsync();
            }
            await RestoreFocusAfterWindowChangeAsync();
            if (Parent != null && Parent.IsRendered && domVirtual != null && (domVirtual.HasDetails || _observingDetails))
            {
                // Observe the rendered detail rows so their real height replaces the estimate (also when the template content resizes).
                _observingDetails = domVirtual.HasDetails;
                await Parent.InvokeMethod("sfBlazor.Grid.observeDomVirtualDetails", new object[] { Parent.DataId }).ConfigureAwait(true);
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    #endregion

    #region Row Generation & Rendering

    private bool HasVirtualSourceChanged()
    {
        object cache = Parent!.VirtualScrollModule!.GeneratedData;
        bool changed = !ReferenceEquals(cache, _generatedDataRef) || Parent.TotalItemCount != _lastTotal;
        _generatedDataRef = cache;
        _lastTotal = Parent.TotalItemCount;
        return changed;
    }

    private object? GetRecord(int index)
    {
        if (IsRowVirtual)
        {
            return Parent!.VirtualScrollModule!.GeneratedData.TryGetValue(index, out IEnumerable<object>? cached) ? cached?.FirstOrDefault() : null;
        }
        return _items != null && index >= 0 && index < _items.Count ? _items[index] : null;
    }

    private async Task EnsureDataAsync(int startIndex, int endIndex)
    {
        var cache = Parent!.VirtualScrollModule!.GeneratedData;
        bool missing = false;
        for (int index = startIndex; index < endIndex; index++)
        {
            if (!cache.ContainsKey(index))
            {
                missing = true;
                break;
            }
        }
        if (!missing)
        {
            return;
        }

        int pageSize = Parent.PageSettings!.PageSize;
        int fetchEnd = Math.Max(endIndex, Math.Min(TotalCount, startIndex + pageSize));
        int fetchStart = Math.Min(startIndex, Math.Max(0, fetchEnd - pageSize));

        _fetching = true;
        try
        {
            await Parent.VirtualScrollModule.FetchRangeForDomAsync(fetchStart, fetchEnd, CurrentScrollTop).ConfigureAwait(true);
        }
        finally
        {
            _fetching = false;
        }
    }

    private async Task GenerateRows()
    {
        Parent?.DomVirtualModule?.ResetEditState();
        Parent?.DomVirtualModule?.ResetDetailState();
        Parent?.DomVirtualModule?.ClearRetainedSelectionState();
        Parent?.SelectionModule?.ResetDomVirtualSelectionOnDataChange();
        _rowCache.Clear();
        SetRenderedRows(new());
        CurrentStartIndex = 0;
        RenderedEndIndex = 0;
        // Flattens grouped data into visible entries (or leaves group mode when the data is not grouped any more).
        Parent?.DomVirtualModule?.BuildGroupEntries(ContentParameters?.Data);
        if (IsGroupMode)
        {
            _items = null;
            CalculateScrollAmplification();
            await UpdateRenderedRows(true);
            return;
        }

        if (IsRowVirtual && Parent != null)
        {
            _items = null;
            CalculateScrollAmplification();
            await UpdateRenderedRows(true);
            return;
        }

        IEnumerable<object>? source = ContentParameters?.Data;
        if (Parent == null || source == null)
        {
            _items = null;
            return;
        }

        // Only the records are kept; no Row<object> is created here.
        _items = source as System.Collections.IList ?? source.ToList();
        CalculateScrollAmplification();

        await UpdateRenderedRows(true);
    }

    /// <summary>
    /// Update rendered rows based on viewport and scroll position.
    /// Row objects are created on demand only for the rows entering the window.
    /// </summary>
    private async Task UpdateRenderedRows(bool force = false)
    {
        CalculateScrollAmplification();
        if (Parent == null || (_items == null && !IsRowVirtual && !IsGroupMode) || ScrollRowCount == 0)
        {
            TrackAddedRows();
            List<Row<object>> emptyWindow = new();
            AttachAddedRows(emptyWindow, 0, 0);
            SetRenderedRows(emptyWindow);
            PublishWindowMetrics();
            if (force || emptyWindow.Count > 0)
            {
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        if (_fetching)
        {
            _refreshAfterFetch = true;
            return;
        }

        
        int visibleRowCount = (ViewportHeight / RowHeight) + 1;

        // Default buffer is one viewport on each side so a wheel/drag step never outruns the rendered window.
        // At least one row of buffer so the row above/below the focused row is always rendered for keyboard navigation.
        int rowBuffer = Math.Max(1, Parent.DomVirtualizationSettings?.RowBuffer ?? visibleRowCount);
        int maxPool = Parent.DomVirtualizationSettings?.GetEffectiveMaxPoolSize() ?? 500;

        (int firstVisible, long rowOffset) = GetEffectiveScrollState(visibleRowCount);
        CurrentRowOffset = rowOffset;
        _firstVisibleIndex = firstVisible;
        _visibleRowCount = visibleRowCount;
        int startIndex = Math.Max(0, firstVisible - rowBuffer);
        int endIndex = Math.Min(ScrollRowCount, firstVisible + visibleRowCount + rowBuffer);
        if (endIndex - startIndex > maxPool)
        {
            endIndex = startIndex + maxPool;
        }

        // Skip the render when the window has not changed (most scroll events within a block).
        if (!force && startIndex == CurrentStartIndex && endIndex == RenderedEndIndex && RenderedRows.Count > 0)
        {
            return;
        }

        if (IsRowVirtual)
        {
            await EnsureDataAsync(startIndex, endIndex);
            if (_refreshAfterFetch)
            {
                _refreshAfterFetch = false;
                await UpdateRenderedRows(force);
                return;
            }
        }

        TrackAddedRows();
        await CaptureEditInputsBeforeLeavingAsync(startIndex, endIndex);
        EnsureWindowRows(startIndex, endIndex);

        DomVirtualHandler<TContent>? domVirtualState = Parent.DomVirtualModule;
        List<Row<object>> windowRows = new(endIndex - startIndex);
        for (int index = startIndex; index < endIndex; index++)
        {
            if (_rowCache.TryGetValue(index, out Row<object>? row))
            {
                windowRows.Add(row);
                // Details are keyed by the data row index (equal to the window index without grouping).
                if (domVirtualState != null && domVirtualState.HasDetails && row.IsDataRow && row.Index is int dataIndex && domVirtualState.TryGetDetailRow(dataIndex, out Row<object> detailRow))
                {
                    // Expansion lives in the handler, so a re-created parent row is marked expanded again and gets its detail row back.
                    MarkExpanded(row, true);
                    windowRows.Add(detailRow);
                }
                else if (row.IsExpand && row.IsDataRow)
                {
                    MarkExpanded(row, false);
                }
            }
        }

        // With row virtualization the first records of the window can be missing from the cache (right after a save refreshed it).
        // The table is placed at the first row that is really rendered; placing it at startIndex leaves a blank gap of the missing rows.
        int firstRenderedIndex = startIndex;
        if (IsRowVirtual && windowRows.Count > 0 && windowRows[0].Index is int firstIndex && firstIndex > startIndex)
        {
            firstRenderedIndex = firstIndex;
        }

        AttachAddedRows(windowRows, startIndex, endIndex);
        SetRenderedRows(windowRows);
        PublishWindowMetrics();
        _windowChanged = true;
        CurrentStartIndex = startIndex;
        RenderedEndIndex = endIndex;
        TranslateY = (Parent.DomVirtualModule?.TopOf(firstRenderedIndex, RowHeight) ?? ((long)firstRenderedIndex * RowHeight)) - CurrentRowOffset;

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Keeps a row cache for exactly the [startIndex, endIndex) window: rows that are still in the window are
    /// reused (stable Uid/key, no re-creation), rows that left the window are dropped, and only the missing
    /// contiguous runs are generated.
    /// </summary>
    private void EnsureWindowRows(int startIndex, int endIndex)
    {
        List<int>? stale = null;
        foreach (int cachedIndex in _rowCache.Keys)
        {
            if (cachedIndex < startIndex || cachedIndex >= endIndex)
            {
                (stale ??= new List<int>()).Add(cachedIndex);
            }
        }
        DomVirtualHandler<TContent>? domVirtual = Parent!.DomVirtualModule;
        if (stale != null)
        {
            foreach (int cachedIndex in stale)
            {
                domVirtual?.CaptureSelectionState(_rowCache[cachedIndex]);
                // A row that carries edit state keeps its model while outside the window; its editor/DOM is not kept.
                if (domVirtual != null && DomVirtualHandler<TContent>.HasEditState(_rowCache[cachedIndex]))
                {
                    domVirtual.RetainedRows[cachedIndex] = _rowCache[cachedIndex];
                }
                _rowCache.Remove(cachedIndex);
            }
        }
        if (domVirtual != null && domVirtual.RetainedRows.Count > 0)
        {
            for (int retained = startIndex; retained < endIndex; retained++)
            {
                if (domVirtual.RetainedRows.Remove(retained, out Row<object>? restored))
                {
                    _rowCache[retained] = restored;
                }
            }
        }

        if (IsGroupMode)
        {
            int entry = startIndex;
            while (entry < endIndex)
            {
                if (_rowCache.ContainsKey(entry))
                {
                    entry++;
                    continue;
                }
                int runStart = entry;
                while (entry < endIndex && !_rowCache.ContainsKey(entry))
                {
                    entry++;
                }
                // One row per entry (footers are one entry per aggregate), so the generated list maps 1:1 to the run.
                List<Row<object>> groupRows = domVirtual!.GenerateGroupEntryRows(runStart, entry - runStart);
                for (int i = 0; i < groupRows.Count; i++)
                {
                    _rowCache[runStart + i] = groupRows[i];
                }
            }
            return;
        }

        RowModelGenerator<TContent>? generator = null;
        int index = startIndex;
        while (index < endIndex)
        {
            if (_rowCache.ContainsKey(index) || GetRecord(index) == null)
            {
                index++;
                continue;
            }

            int runStart = index;
            List<object> slice = new();
            while (index < endIndex && !_rowCache.ContainsKey(index) && GetRecord(index) is object record)
            {
                slice.Add(record);
                index++;
            }

            generator ??= new RowModelGenerator<TContent>(Parent!);
            if (IsRowVirtual)
            {
                // Generator numbers rows from VirtualRowIndex when row virtualization is on
                Parent!.VirtualScrollModule!.VirtualRowIndex = runStart;
            }
            int position = runStart;
            foreach (Row<object> row in generator.GeneratorRows(slice, runStart))
            {
                if (!row.IsDetailRow)
                {
                    _rowCache[position++] = row;
                }
            }
        }
    }

    /// <summary>
    /// Added rows are not data records, so the window rebuild would drop them. They are remembered here and re-attached
    /// at the top / bottom of the data when that end of the data is inside the window.
    /// </summary>
    private void TrackAddedRows()
    {
        DomVirtualHandler<TContent>? domVirtual = Parent?.DomVirtualModule;
        if (domVirtual == null)
        {
            return;
        }
        List<Row<object>>? newTop = null;
        foreach (Row<object> row in RenderedRows)
        {
            if (domVirtual.AddedRows.Contains(row))
            {
                continue;
            }
            if (row.IsAddedTop)
            {
                (newTop ??= new List<Row<object>>()).Add(row);
            }
            else if (row.IsAddedBottom)
            {
                domVirtual.AddedRows.Add(row);
            }
        }
        // The window list shows the newest top row first, so new top rows go in front of the older ones in the same order.
        if (newTop != null)
        {
            domVirtual.AddedRows.InsertRange(0, newTop);
        }
        domVirtual.AddedRows.RemoveAll(row => !row.IsAddedTop && !row.IsAddedBottom);
    }

    private void AttachAddedRows(List<Row<object>> windowRows, int startIndex, int endIndex)
    {
        DomVirtualHandler<TContent>? domVirtual = Parent?.DomVirtualModule;
        if (domVirtual == null || domVirtual.AddedRows.Count == 0)
        {
            return;
        }
        int topPosition = 0;
        foreach (Row<object> row in domVirtual.AddedRows)
        {
            if (row.IsAddedTop && startIndex == 0)
            {
                windowRows.Insert(topPosition++, row);
            }
            else if (row.IsAddedBottom && endIndex == ScrollRowCount)
            {
                windowRows.Add(row);
            }
        }
    }

    /// <summary>
    /// The editors commit typed text on blur, so text that was typed but not committed exists only in the DOM input.
    /// It is read once, just before the window render that removes the editing row, and re-applied when the editor is created again.
    /// </summary>
    private async Task CaptureEditInputsBeforeLeavingAsync(int startIndex, int endIndex)
    {
        Row<object>? editedRow = Parent?.EditModule?.EditedRow;
        if (Parent == null || Parent.DomVirtualModule == null || !Parent.IsEdit || editedRow == null || !RenderedRows.Contains(editedRow) || !Parent.IsRendered)
        {
            return;
        }
        bool leaves = editedRow.IsAddedTop ? startIndex != 0
            : editedRow.IsAddedBottom ? endIndex != ScrollRowCount
            : editedRow.Index is int index && (index < startIndex || index >= endIndex);
        if (leaves)
        {
            await Parent.DomVirtualModule.CaptureEditInputsAsync().ConfigureAwait(true);
        }
    }

    private static void MarkExpanded(Row<object> row, bool expanded)
    {
        row.IsExpand = expanded;
        foreach (Cell<object> cell in row.Cells)
        {
            if (cell.CellType == CellType.Detail)
            {
                cell.DetailRowExpand = expanded;
            }
        }
    }

    private void CalculateScrollAmplification()
    {
        if (TotalDataHeight > BrowserMaxScrollHeight)
        {
            ScrollAmplificationFactor = (double)BrowserMaxScrollHeight / TotalDataHeight;
        }
        else
        {
            ScrollAmplificationFactor = 1.0;
        }
    }

    private (int FirstVisible, long RowOffset) GetEffectiveScrollState(int visibleRowCount)
    {
        if (ScrollRowCount <= 0)
        {
            return (0, 0);
        }

        long additionalPixels = Math.Max(0, TotalDataHeight - BrowserMaxScrollHeight);
        long maxScrollable = Math.Max(1, Math.Min(TotalDataHeight, BrowserMaxScrollHeight) - ViewportHeight);
        bool nearBottom = CurrentScrollTop >= maxScrollable - 1;
        if (nearBottom)
        {
            DomVirtualHandler<TContent>? bottomDetails = Parent?.DomVirtualModule;
            int firstAtBottom = bottomDetails != null && bottomDetails.HasDetails
                ? Math.Min(ScrollRowCount - 1, bottomDetails.IndexAt(Math.Max(0, TotalDataHeight - ViewportHeight), RowHeight))
                : Math.Max(0, TrackRowCount - visibleRowCount);
            return (firstAtBottom, additionalPixels);
        }

        double scrollPercent = Math.Min(1d, Math.Max(0d, CurrentScrollTop / (double)maxScrollable));
        long rowOffset = (long)Math.Floor(scrollPercent * additionalPixels);
        long effectiveScrollTop = CurrentScrollTop + rowOffset;
        // With expanded details the row at an offset comes from the sorted detail list (O(log k)), not from a division.
        DomVirtualHandler<TContent>? details = Parent?.DomVirtualModule;
        int firstVisible = details != null && details.HasDetails
            ? Math.Min(ScrollRowCount - 1, details.IndexAt(effectiveScrollTop, RowHeight))
            : (int)Math.Min(ScrollRowCount - 1, effectiveScrollTop / RowHeight);
        return (firstVisible, rowOffset);
    }

    #endregion

    #region Focus and Keyboard Support

    /// <summary>
    /// The rendered window is the grid's row collection while DOM virtualization is on, so the focus,
    /// selection and edit code that reads <c>Parent.Rows</c> sees the rows that actually exist in the DOM.
    /// </summary>
    private void SetRenderedRows(List<Row<object>> rows)
    {
        RenderedRows = rows;
        if (Parent != null)
        {
            Parent.Rows = rows;
        }
    }

    private void PublishWindowMetrics()
    {
        if (Parent?.DomVirtualModule != null)
        {
            Parent.DomVirtualModule.TotalRowCount = ScrollRowCount;
        }
    }

    #region IDomVirtualContent

    public int RenderedRowCount => RenderedRows.Count;

    public int WindowStartIndex => CurrentStartIndex;

    public int WindowEndIndex => RenderedEndIndex;

    public bool IsFetching => _fetching || _refreshAfterFetch;

    public SemaphoreSlim EnsureLock { get; } = new(1, 1);

    public bool HasRenderedRow(int rowIndex) => RenderedRows.Any(row => row.Index == rowIndex);

    public Task UpdateRenderedRowsAsync(bool force) => UpdateRenderedRows(force);

    public void ClearRowCache()
    {
        if (Parent?.DomVirtualModule != null)
        {
            foreach (Row<object> row in _rowCache.Values)
            {
                Parent.DomVirtualModule.CaptureSelectionState(row);
            }
        }
        _rowCache.Clear();
    }

    #endregion

    /// <summary>
    /// A row that leaves the window is dropped and re-created with a new Uid when it comes back, so its focus state is lost.
    /// When the focused row is visible again, re-apply the focus through the existing focus pipeline.
    /// </summary>
    private async Task RestoreFocusAfterWindowChangeAsync()
    {
        FocusHandler<TContent>? focus = Parent?.FocusModule;
        if (Parent == null || focus == null)
        {
            return;
        }
        if (focus.HasPendingDomFocus)
        {
            await focus.ApplyPendingDomFocusAsync().ConfigureAwait(true);
            return;
        }
        if (focus.DomFocusRowIndex == null || focus.DomFocusCellIndex == null || Parent.IsEdit)
        {
            return;
        }
        int rowIndex = focus.DomFocusRowIndex.Value;
        if (rowIndex < _firstVisibleIndex || rowIndex >= _firstVisibleIndex + _visibleRowCount)
        {
            return;
        }
        Row<object>? row = RenderedRows.Find(r => r.Index == rowIndex && r.IsDataRow);
        Cell<object>? cell = row?.Cells.Find(c => c.Index == focus.DomFocusCellIndex);
        if (row == null || cell == null || cell.IsFocused)
        {
            return;
        }
        focus.ClearCurrent();
        focus.SetCurrent(row, cell, focus.DomFocusOutline);
        Parent.SoftRefresh = true;
        Parent.EventAggregator.Trigger("RowStateChanged", row);
        await focus.Focus(row.Uid!, cell.Uid!, cellColIndex: cell.Index!.Value + 1).ConfigureAwait(true);
    }

    #endregion

    #region Event Handlers

    /// <summary>
    /// Receives the latest scrollTop from the client (scrollbar and content are kept in sync in JS)
    /// and re-renders the visible row window only when it changed.
    /// </summary>
    private async Task HandleDomVirtualScroll(Task task, object args)
    {
        if (args is int scrollTop)
        {
            CurrentScrollTop = scrollTop;
            await UpdateRenderedRows();
        }
    }

    private async Task HandleDomVirtualMaxHeightChanged(Task task, object args)
    {
        if (args is int maxHeight && maxHeight > 0 && maxHeight != BrowserMaxScrollHeight)
        {
            BrowserMaxScrollHeight = maxHeight;
            CalculateScrollAmplification();
            await UpdateRenderedRows(true);
        }
    }

    /// <summary>
    /// Task 01: Event handler triggered when RHeight is updated in SfGrid.Lifecycle.
    /// This is called from SfGrid after RowHeight is synced from client-side initialization.
    /// Mirrors the VirtualComponentUpdate event pattern from GridVirtualContent.razor
    /// </summary>
    private void DomVirtualComponentUpdate(object args)
    {
        // Task 01: When RHeight is updated in VirtualScrollModule from SfGrid.Lifecycle,
        // this event fires to trigger re-render with updated heights
        // Accepts object parameter to match Action<object> delegate signature
        InvokeAsync(StateHasChanged);
    }

    #endregion

    #region Style Methods

    private string GetGridContentClass()
    {
        if (Parent == null) return "e-gridcontent";
        
        string classNames = "e-gridcontent";
        if (Parent.AllowTextWrap && Parent.TextWrapSettings != null && Parent.TextWrapSettings.WrapMode.Equals(WrapMode.Content))
        {
            classNames = $"{classNames} e-wrap";
        }
        if (Parent.EnableAdaptiveUI && !(Parent.Toolbar != null || ((IGrid)Parent).GridTemplates?.ToolbarTemplate != null))
        {
            classNames = $"{classNames} e-responsive-header";
        }
        
        return classNames;
    }

    private string GetGridContentStyle()
    {
        // e-gridcontent should only have position:relative
        // The content area owns the height
        return "position: relative;";
    }

    private string GetContentClassName()
    {
        if (Parent == null) return "e-content";
        
        string className = "e-content";
        if (!string.Equals("auto", Parent.Height, StringComparison.Ordinal))
        {
            className = $"{className} e-yscroll";
        }
        
        return className;
    }

    private string GetContentStyle()
    {
        // e-content owns only position and height
        // Overflow is handled by e-yscroll class
        if (Parent == null) return "position: relative; height: 300px;";
        
        string styleText = "position: relative;";
        if (!string.Equals("auto", Parent.Height, StringComparison.Ordinal))
        {
            styleText = $"{styleText} height: {GridUtils.FormarUnit(Parent.Height)};";
        }
        else
        {
            styleText = $"{styleText} height: 300px;";
        }
        
        return styleText;
    }

    private string GetStyles()
    {
        // Mirrors GridVirtualContent.razor GetStyles() method
        string styleText = "";
        if (Parent == null || Parent.VirtualScrollModule == null) return styleText;
        
        styleText = $"transform: translate({Parent.VirtualScrollModule.TranslateX}px,{TranslateY}px); ";
        
        if (Parent.EnableColumnVirtualization && Parent.FreezeModule!.GetFrozenCount() == 0)
        {
            styleText = string.Concat(styleText, $"width: {Parent.VirtualScrollModule.GetVTableWidth()}px; ");
        }
        
        if (Parent.FreezeModule!.GetFrozenCount() == 0 || ((!Parent.EnableColumnVirtualization || Parent.OverscanCount > 0) && Parent.FreezeModule!.GetFrozenCount() != 0))
        {
            bool isVerticalMode = Parent.EnableAdaptiveUI ? Parent.RowRenderingMode.Equals(RowDirection.Vertical) && (Parent.Width == "100%" || Parent.Width == "auto") : false;
            string display = isVerticalMode ? "position:absolute;top: 0;left: 0;right: 0;" : "position:absolute";
            styleText = string.Concat(styleText, $"{display}");
        }
        
        if (Parent.FreezeModule!.GetFrozenCount() == 0 && Parent.EnableColumnVirtualization && !Parent.EnableVirtualization && (Parent.Height == "auto" || Parent.Height == "100%"))
        {
            styleText = string.Concat(styleText, " ;position:unset");
        }
        
        return styleText;
    }

    private string GetScrollbarTrackStyles()
    {
        int effectiveHeight = (int)Math.Min(TotalDataHeight * ScrollAmplificationFactor, BrowserMaxScrollHeight);

        return $"width: 1px; height: {effectiveHeight}px; position: relative;";
    }

    private string GetVirtualTrackStyles()
    {
        // Task 01: Mirrors GridVirtualContent.razor GetVirtualTrackStyles() method
        // Height = total items * row height (gives complete scroll track height)
        if (Parent == null || Parent.VirtualScrollModule == null) return "height: 0px; width: 100%;";
        
        int height = 0;
        int itemCount = TrackRowCount;
        
        if (itemCount == 0)
        {
            itemCount = TotalCount;
        }
        
        // Task 01: Ensure RHeight is set, fallback to RowHeight if needed
        int effectiveRowHeight = Parent.VirtualScrollModule.RHeight > 0 
            ? Parent.VirtualScrollModule.RHeight 
            : (Parent.RowHeight > 0 ? (int)Parent.RowHeight : RowHeight);
        
        height = (int)Math.Min(((long)itemCount * effectiveRowHeight) + (Parent.DomVirtualModule?.DetailTotalHeight ?? 0), BrowserMaxScrollHeight);
        
        return $"height: {height}px; width:100%;";
    }

    #endregion

    #region Utility Methods

    private string GetRowKey(Row<object> row)
    {
        if (row == null) return string.Empty;
        
        string recordId = !string.IsNullOrEmpty(row.Uid) 
            ? row.Uid 
            : row.Index?.ToString() ?? string.Empty;
        
        return $"{row.RowType}_{recordId}";
    }

    private int GetVisibleColumnsCount()
    {
        if (Parent == null) return 1;
        
        var columns = GridUtils.GetColumns(Parent);
        return columns?.Where(c => c.Visible).Count() ?? 1;
    }

    #endregion

    #region Disposal

    void IDisposable.Dispose()
    {
        Parent?.EventAggregator?.RemoveAsync("DomVirtualScroll");
        Parent?.EventAggregator?.RemoveAsync("DomVirtualMaxHeightChanged");
        Parent?.EventAggregator?.Remove("DomVirtualComponentUpdate");
        RenderedRows?.Clear();
        _rowCache.Clear();
        Parent?.DomVirtualModule?.ResetEditState();
        Parent?.DomVirtualModule?.ResetDetailState();
        Parent?.DomVirtualModule?.ClearRetainedSelectionState();
        Parent?.DomVirtualModule?.ResetGroupState();
        EnsureLock.Dispose();
        if (Parent?.DomVirtualModule != null && ReferenceEquals(Parent.DomVirtualModule.Content, this))
        {
            Parent.DomVirtualModule.Content = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        RenderedRows?.Clear();
        _rowCache.Clear();
        await Task.CompletedTask;
    }

    #endregion
}
