@inherits GridTestBase
@using Bunit
@using Syncfusion.Blazor.Tests
@using Syncfusion.Blazor.Tests.Grids
@using Syncfusion.Blazor.Grids

<SfFixture @ref="selectedRowFixture" Test="HidingOrderIdAfterSelectingRow" Description="BLAZ-1053096 hides OrderID after row selection with HeaderCellInfo">
    <ComponentUnderTest>
        <SfGrid @ref="selectedRowGrid" DataSource="GenerateOrderData()" ShowColumnChooser="true" Toolbar="@ToolbarItems" AllowResizing="true">
            <GridEvents TValue="Order" HeaderCellInfo="HeaderCellHandler"></GridEvents>
            <GridEditSettings AllowAdding="true" AllowDeleting="true" AllowEditing="true"></GridEditSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    private readonly string[] ToolbarItems = { "Add", "Edit", "Delete", "Update", "Cancel", "ColumnChooser" };
    private SfFixture selectedRowFixture { get; set; }
    private SfFixture editRowFixture { get; set; }
    private SfGrid<Order> selectedRowGrid;
    private SfGrid<Order> editRowGrid;
    private int headerCellInfoCount;

    private async void HidingOrderIdAfterSelectingRow(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        await cut.Instance.SelectRowAsync(0);
        HideOrderIdColumn(cut);
        await AssertOrderIdIsHidden(cut);
    }

    private async void HidingOrderIdAfterStartingEdit(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        await cut.Instance.SelectRowAsync(0);
        await cut.Instance.StartEditAsync();
        cut.WaitForState(() => cut.FindAll(".e-gridform").Count > 0, TimeSpan.FromMilliseconds(1000));
        HideOrderIdColumn(cut);
        await AssertOrderIdIsHidden(cut);
    }

    private void HideOrderIdColumn(IRenderedComponent<SfGrid<Order>> cut)
    {
        cut.Find(".e-columnchooser-btn").Click();
        cut.FindAll(".e-icons.e-choosercheck")[1].Click();
        cut.Find(".e-cc_okbtn").Click();
    }

    private async Task AssertOrderIdIsHidden(IRenderedComponent<SfGrid<Order>> cut)
    {
        var orderIdColumn = (await cut.Instance.GetColumnsAsync()).First(column => column.Field == nameof(Order.OrderID));
        Assert.False(orderIdColumn.Visible);
        Assert.Empty(cut.FindAll(".e-ccdlg.e-popup-open"));
        await cut.Instance.SelectRowAsync(0);
        cut.WaitForAssertion(() => Assert.Single(cut.Instance.SelectedRecords), TimeSpan.FromMilliseconds(1000));
        Assert.Contains("Order Date", cut.Markup);
        Assert.Contains("Freight", cut.Markup);
        Assert.InRange(headerCellInfoCount, 1, 100);
    }

    private void HeaderCellHandler(HeaderCellInfoEventArgs args)
    {
        headerCellInfoCount++;
    }
}
