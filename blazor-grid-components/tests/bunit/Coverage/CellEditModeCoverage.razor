            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture7 { get; set; }
    private SfGrid<SimpleOrder> GridPublicMethods;

    public async Task PublicMethodsCoverage(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<SimpleOrder>>();
        var viewRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        var firstRecord = viewRecords[0];
        var primaryKeyValue = firstRecord.OrderID;

        // Test 1: save single cell
        await cut.Instance.SetCellValueAsync(primaryKeyValue, "CustomerID", "NewCustomer");
        viewRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.True(viewRecords[0].CustomerID == "NewCustomer", "Single cell saved");

        // Test 2: save multiple cells
        var cellUpdates = new List<CellUpdate>
        {
            new CellUpdate { PrimaryKeyValue = primaryKeyValue, ColumnField = "Amount", NewValue = 150.5 },
            new CellUpdate { PrimaryKeyValue = viewRecords[1].OrderID, ColumnField = "Status", NewValue = "Active" }
        };
        await cut.Instance.SetCellValueAsync(cellUpdates);
        viewRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.True(viewRecords[0].Amount == 150.5, "Multiple cells saved");
    }
}

<SfFixture @ref="fixture8" TestAsync="CellEditCancellingEvents" Description="Cancel on Escape">
    <ComponentUnderTest>
        <SfGrid @ref="GridCancelEvents" DataSource="GenerateSimpleOrderData()" @bind-SelectedRowIndices="@SelectedRowIndices">
            <GridEditSettings AllowEditing="true" Mode="EditMode.Cell"></GridEditSettings>
            <GridEvents OnCellEdit="OnCellEdit" TValue="SimpleOrder"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(SimpleOrder.OrderID) HeaderText="Order ID" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field=@nameof(SimpleOrder.CustomerID) HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field=@nameof(SimpleOrder.Amount) HeaderText="Amount" Width="120"></GridColumn>
                <GridColumn Field=@nameof(SimpleOrder.Status) HeaderText="Status" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture8 { get; set; }
    private SfGrid<SimpleOrder> GridCancelEvents;
    private int[] SelectedRowIndices;
    private bool cellEditingEventFired2 = false;
    private string lastEditedColumn = "";

    public async Task CellEditCancellingEvents(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<SimpleOrder>>();
        
        cellEditingEventFired2 = false;
        await cut.Instance.EditCellAsync(0, "CustomerID");
        Assert.True(cellEditingEventFired2, "CellEditing event fired when entering edit mode");
        Assert.True(lastEditedColumn == "CustomerID", "Event has correct column info");

        var gridFocusHandler = cut.Instance.FocusModule;
        var dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false);
        var targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 1); // CustomerID is at index 1
        
        await gridFocusHandler.ProcessGridKeyDown(
            new KeyboardEventArgs { Key = "Escape", Code = "Escape" }
        );
        
        var viewRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.True(viewRecords.Count > 0, "Grid data remains after cancel");
    }

    private Task OnCellEdit(CellEditArgs<SimpleOrder> args)
    {
        cellEditingEventFired2 = true;
        lastEditedColumn = args.ColumnName;
        return Task.CompletedTask;
    }
}

