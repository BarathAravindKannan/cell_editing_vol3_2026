@inherits GridTestBase

@using Syncfusion.Blazor.Grids
@using System.Linq

<SfFixture @ref="fixture1" TestAsync="CellEditNavigation" Description="Core Cell Edit Navigation - Tab/Shift+Tab/Escape/F2 keyboard handling">
    <ComponentUnderTest>
        <SfGrid @ref="Grid1" DataSource="GenerateSimpleOrderData()" AllowSelection="true">
            <GridEditSettings AllowEditing="true" Mode="EditMode.Cell" AllowAdding="false" AllowDeleting="false"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(SimpleOrder.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(SimpleOrder.CustomerID) HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field=@nameof(SimpleOrder.Amount) HeaderText="Amount" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(SimpleOrder.Status) HeaderText="Status" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture1 { get; set; }
    private SfGrid<SimpleOrder> Grid1;
    private bool cellEditingFired = false;

    public async Task CellEditNavigation(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<SimpleOrder>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered");

        // Test 1: Tab navigation - Edit cell, change value, press Tab to move to next cell

        // Enter edit mode on cell
        await cut.Instance.EditCellAsync(0, "CustomerID");
        var viewRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        var originalValue = viewRecords[0].CustomerID;
        var gridFocusHandler = cut.Instance.FocusModule;
        var dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false);
        var targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 1); // CustomerID is at index 1

        // Simulate Tab key to save and move to next cell
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "Tab", Code = "Tab" },
            row: dataRow,
            cell: targetCell,
            isHeader: false
        );

        // Test 2: Shift+Tab navigation - Navigate to previous cell
        dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false);
        targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 2); // Amount is at index 2
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "Tab", Code = "Tab", ShiftKey = true },
            row: dataRow,
            cell: targetCell,
            isHeader: false
        );

        // CustomerID cell to Amount
        dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false);
        targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 1);
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "Tab", Code = "Tab" },
            row: dataRow,
            cell: targetCell,
            isHeader: false
        );

        // Amount to Status cell navigation
        dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false);
        targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 2);
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "Tab", Code = "Tab" },
            row: dataRow,
            cell: targetCell,
            isHeader: false
        );
        // Status to Next Row Editable cell navigation
        dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false);
        targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 3);
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "Tab", Code = "Tab" },
            row: dataRow,
            cell: targetCell,
            isHeader: false
        );

        // first Editable cell to last editable cell in previous row
        dataRow = cut.Instance.Rows?.FirstOrDefault(r => r.Visible != false && r.Index == 1);
        targetCell = dataRow?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 1);
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "Tab", Code = "Tab", ShiftKey = true },
            row: dataRow,
            cell: targetCell,
            isHeader: false
        );

        await cut.Instance.EndEditAsync();

        // Test 4: F2 to enter edit mode
        var dataRow3 = cut.Instance.Rows?.ElementAtOrDefault(2);
        var targetCell3 = dataRow3?.Cells?.FirstOrDefault(c => c.Visible && c.Index == 1); // CustomerID is at index 1
        
        await gridFocusHandler.ProcessKeyDown(
            new KeyboardEventArgs { Key = "F2", Code = "F2" },
            row: dataRow3,
            cell: targetCell3,
            isHeader: false
        );

        viewRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.True(viewRecords.Count > 0, "Records still available after navigation");
    }
}

