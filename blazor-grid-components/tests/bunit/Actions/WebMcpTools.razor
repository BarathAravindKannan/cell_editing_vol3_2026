        using var response = await InvokeTool(bridge, "DisabledWebMcpGrid_getCurrentViewRecords", "{}");
        Assert.True(response.RootElement.TryGetProperty("isError", out var isError));
        Assert.True(isError.GetBoolean());
        Assert.True(response.RootElement.TryGetProperty("content", out var content));
        Assert.Equal(JsonValueKind.Array, content.ValueKind);
        //Assert.True(IsError(response));
        //Assert.Contains("WebMCP is not enabled", GetResponseText(response));
