    private async Task WebMcpIsDirtyTool_ReportsCleanBatchState(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.NotNull(cut);
        var bridge = Assert.IsType<GridJSInteropAdaptor<Order>>(cut.Instance._jsAdaptor);

        using var state = await InvokeTool(bridge, "WebMcpBatchEditGrid_isDirty", "{}");
        Assert.False(IsError(state));
        Assert.False(ReadIsDirtyResult(state));
    }

    private async Task WebMcpDeleteRowTool_DeletesByCurrentViewIndex(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.NotNull(cut);
        var bridge = Assert.IsType<GridJSInteropAdaptor<Order>>(cut.Instance._jsAdaptor);
        var before = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.NotEmpty(before);

        using var response = await InvokeTool(bridge, "WebMcpDeleteGrid_deleteRow", "{\"rowIndex\":1}");
        Assert.False(IsError(response));

        var after = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.Equal(before.Count - 1, after.Count);
    }

    private static bool ReadIsDirtyResult(JsonDocument response)
    {
        var text = response.RootElement.GetProperty("content")[0].GetProperty("text").GetString();
        using var payload = JsonDocument.Parse(text!);
        return payload.RootElement.GetProperty("isDirty").GetBoolean();
    }

    private async Task HandleWebMcpToolExecution(WebMcpToolExecuteEventArgs args)
    {
        capturedToolCommand = args.Command;
        if (eventBehavior == "cancel")
        {
            args.Cancel = true;
        }
        else if (eventBehavior == "result" && args.ToolName?.EndsWith("customSummary", StringComparison.Ordinal) == true)
        {
            capturedToolArgs = args.Arguments;
            args.Result = new { handled = true };
        }
    }

    private static async Task<JsonDocument> InvokeTool(GridJSInteropAdaptor<Order> bridge, string command, string argsJson)
    {
        return JsonDocument.Parse(await bridge.InvokeWebMcpToolExecute(command, argsJson));
    }

    private static bool IsError(JsonDocument response)
    {
        return response.RootElement.TryGetProperty("isError", out var value) && value.GetBoolean();
    }

    private static string CreateSampleArguments(IWebMcpTool tool)
    {
        using var schema = JsonDocument.Parse(JsonSerializer.Serialize(tool.InputSchema));
        var arguments = new Dictionary<string, object>();
        if (schema.RootElement.TryGetProperty("properties", out var properties))
        {
            foreach (var property in properties.EnumerateObject())
            {
                arguments[property.Name] = CreateSampleValue(property.Value, property.Name);
            }
        }

        return JsonSerializer.Serialize(arguments);
    }

    private static object CreateSampleValue(JsonElement schema, string propertyName)
    {
        if (propertyName == "key")
        {
            return 1001;
        }

        if (schema.TryGetProperty("enum", out var enumValues) && enumValues.GetArrayLength() > 0)
        {
            return enumValues[0].GetString();
        }

        if (!schema.TryGetProperty("type", out var typeElement))
        {
            return propertyName is "data" or "rowData"
                ? new Dictionary<string, object> { ["OrderID"] = 1001, ["CustomerID"] = "ALFKI", ["ShipCountry"] = "USA" }
                : "ALFKI";
        }

        switch (typeElement.GetString())
        {
            case "string":
                if (propertyName == "direction") return "Ascending";
                if (propertyName == "filterOperator") return "contains";
                if (propertyName == "format") return "csv";
                if (propertyName == "action") return "goto";
                if (propertyName == "fileName") return "webmcp-coverage";
                if (propertyName == "predicate") return "and";
                if (propertyName.Contains("field", StringComparison.OrdinalIgnoreCase) ||
                    propertyName.Contains("column", StringComparison.OrdinalIgnoreCase)) return "CustomerID";
                return "ALFKI";

            case "integer":
            case "number":
                return 1;

            case "boolean":
                return false;

            case "array":
                return schema.TryGetProperty("items", out var items)
                    ? new[] { CreateSampleValue(items, propertyName) }
                    : Array.Empty<object>();

            case "object":
                var value = new Dictionary<string, object>();
                if (schema.TryGetProperty("properties", out var nestedProperties))
                {
                    foreach (var property in nestedProperties.EnumerateObject())
                    {
                        value[property.Name] = CreateSampleValue(property.Value, property.Name);
                    }
                }
                return value;

            default:
                return null;
        }
    }

