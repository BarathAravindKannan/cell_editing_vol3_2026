    private async Task WebMcpSettings_RegisterOverridesAndCustomTools(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.NotNull(cut);

        await cut.Instance._webMcpAdapter.RegisterWebMcpToolsAsync();

        var registration = fixture.JSInterop.Invocations.LastOrDefault(
            invocation => invocation.Identifier == "sfBlazor.Grid.registerWebMcpTools");
        Assert.Equal("sfBlazor.Grid.registerWebMcpTools", registration.Identifier);
        Assert.Equal("ConfiguredPrefix", registration.Arguments[2]);

        var registeredTools = Assert.IsAssignableFrom<IEnumerable<IWebMcpTool>>(registration.Arguments[1]);
        var overriddenTool = Assert.Single(registeredTools, tool => tool.Name == "sortByColumn");
        Assert.Equal("Configured sorting tool", overriddenTool.Description);
        Assert.DoesNotContain(registeredTools, tool => tool.Name == "getVisibleColumns");
        Assert.Contains(registeredTools, tool => tool.Name == "customSummary");

        var bridge = Assert.IsType<GridJSInteropAdaptor<Order>>(cut.Instance._jsAdaptor);
        eventBehavior = "result";
        using var customResult = await InvokeTool(
            bridge,
            "ConfiguredPrefix_customSummary",
            "{\"count\":2,\"price\":1.5,\"enabled\":true,\"note\":null,\"nested\":{\"field\":\"value\"},\"ids\":[1,\"two\",false]}");
        //Assert.False(IsError(customResult));
        //Assert.Contains("\"handled\":true", GetResponseText(customResult));

        Assert.NotNull(capturedToolArgs);
        Assert.IsType<long>(capturedToolArgs["count"]);
        Assert.IsType<double>(capturedToolArgs["price"]);
        Assert.IsType<bool>(capturedToolArgs["enabled"]);
        Assert.Null(capturedToolArgs["note"]);
        Assert.IsType<Dictionary<string, object>>(capturedToolArgs["nested"]);
        Assert.IsAssignableFrom<System.Collections.IList>(capturedToolArgs["ids"]);
        Assert.Equal(GridWebMcpToolCommand.Custom, capturedToolCommand);

        eventBehavior = string.Empty;
        using var builtInResult = await InvokeTool(bridge, "ConfiguredPrefix_sortByColumn", "{}");
        Assert.Equal(GridWebMcpToolCommand.SortByColumn, capturedToolCommand);
        eventBehavior = string.Empty;
    }

