<!-- ================================================================== -->
<!-- F4.4: RowBuffer & OverscanCount Separation Tests                  -->
<!-- ================================================================== -->

<SfFixture @ref="fixture6" Test="RowBuffer_OverscanCount_IndependentRead" Description="[OPSX-20261026-introduce-dom-virtualization-feature] RowBuffer and OverscanCount read independently">
    <ComponentUnderTest>
        <SfGrid @ref="Grid6" DataSource="GetVirtualData()" Height="400" Width="400" 
                EnableDomVirtualization="true" EnableVirtualization="true" OverscanCount="5">
            <GridDomVirtualizationSettings RowBuffer="20" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" HeaderText="Order ID"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture6 { get; set; }
    private SfGrid<Order> Grid6;

    void RowBuffer_OverscanCount_IndependentRead(Fixture fixture6)
    {
        var cut = fixture6.GetComponentUnderTest<SfGrid<Order>>();
        
        // OverscanCount = 5 (virtual scrolling / query buffer)
        Assert.Equal(5, cut.Instance.OverscanCount);
        
        // RowBuffer = 20 (DOM virtualization / render buffer)
        Assert.Equal(20, cut.Instance.DomVirtualizationSettings.RowBuffer);
        
        // They should not be merged or aliased
        Assert.NotEqual(cut.Instance.OverscanCount, cut.Instance.DomVirtualizationSettings.RowBuffer);
    }
}

