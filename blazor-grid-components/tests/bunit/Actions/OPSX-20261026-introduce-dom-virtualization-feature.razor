<!-- ================================================================== -->
<!-- F4.6: Paging Composition Tests                                    -->
<!-- ================================================================== -->

<SfFixture @ref="fixture8" Test="Paging_PageChange_BufferResets" Description="[OPSX-20261026-introduce-dom-virtualization-feature] Page change resets buffer">
    <ComponentUnderTest>
        <SfGrid @ref="Grid8" DataSource="GetVirtualData()" Height="400" Width="400" 
                EnableDomVirtualization="true" AllowPaging="true">
            <GridDomVirtualizationSettings RowBuffer="20" MaxPoolSize="100" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" HeaderText="Order ID"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture8 { get; set; }
    private SfGrid<Order> Grid8;

    async void Paging_PageChange_BufferResets(Fixture fixture8)
    {
        var cut = fixture8.GetComponentUnderTest<SfGrid<Order>>();
        
        Assert.True(cut.Instance.AllowPaging, "Paging should be enabled");
        Assert.Equal(1, cut.Instance.PageSettings.CurrentPage);
        
        // Change to page 2
        await cut.Instance.GoToPageAsync(2);
        cut.WaitForState(() => cut.Instance.PageSettings.CurrentPage == 2, TimeSpan.FromMilliseconds(1000));
        
        Assert.Equal(2, cut.Instance.PageSettings.CurrentPage, "Should be on page 2");
        // Buffer should be reset and rows rebound to new page's records
    }
}

