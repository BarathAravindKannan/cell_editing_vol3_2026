            <GridDomVirtualizationSettings MaxPoolSize="50" />
            <GridGroupSettings>
                <GridGroupSettingsColumns>
                    <GridGroupSettingsColumn Field="@nameof(Order.CustomerID)"></GridGroupSettingsColumn>
                </GridGroupSettingsColumns>
            </GridGroupSettings>
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture9 { get; set; }
    private SfGrid<Order> Grid9;

    void Grouping_StickyGroupHeaders_NotCountedInCeiling(Fixture fixture9)
    {
        var cut = fixture9.GetComponentUnderTest<SfGrid<Order>>();
        
        Assert.True(cut.Instance.AllowGrouping, "Grouping should be enabled");
        Assert.Equal(50, cut.Instance.DomVirtualizationSettings.MaxPoolSize);
        
