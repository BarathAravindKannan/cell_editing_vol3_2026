@* Fixture 4: Column index preserved across Ctrl+Arrow navigation *@
<SfFixture @ref="fixture4" Test="CtrlArrow_ColumnIndexPreserved" Description="[OPSX-20261016-ctrl-arrow-virtualization-nav] Column index preserved across Ctrl+Arrow navigation">
    <ComponentUnderTest>
        <SfGrid @ref="Grid4" DataSource="GenerateVirtualData4()" Height="400" Width="800" EnableVirtualization="true" RowHeight="38">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" IsPrimaryKey="true" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" Width="130" HeaderText="Order Date"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="100" HeaderText="Freight" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture4 { get; set; }
    private SfGrid<Order> Grid4;

    void CtrlArrow_ColumnIndexPreserved(Fixture fixture4)
    {
        var cut = fixture4.GetComponentUnderTest<SfGrid<Order>>();
        
        // Set SelectedCellIndex to simulate focus on a specific column
        if (cut.Instance.Rows?.Count > 0)
        {
            var row = cut.Instance.Rows[0];
            if (row?.Cells?.Count > 2)
            {
                cut.Instance.FocusModule.SelectedCellIndex = 2;
                
                var keyboardEvent = new KeyboardEventArgs
                {
                    Key = "ArrowDown",
                    Code = "ArrowDown",
                    CtrlKey = true,
                    ShiftKey = false,
                    AltKey = false,
                    MetaKey = false,
                };

                cut.InvokeAsync(async () => 
                    await cut.Instance.FocusModule.ProcessKeyDown(keyboardEvent, row, row.Cells[2])
                ).Wait();

                // Verify column index was passed to ScrollIntoViewAsync
                Assert.Equal(cut.Instance.TotalItemCount - 1, cut.Instance.VirtualScrollModule.CurrentRowIndex);
            }
        }
    }

    public List<Order> GenerateVirtualData4()
    {
        return Enumerable.Range(1, 150).Select(x => new Order()
        {
            OrderID = 4000 + x,
            CustomerID = "BOLID" + x,
            Freight = 11.1 + x,
            OrderDate = new DateTime(2013, 8, 1).AddDays(x),
        }).ToList();
    }
}


