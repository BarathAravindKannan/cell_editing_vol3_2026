@inherits GridTestBase

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Grids.Internal

@* OPSX-20261016-ctrl-arrow-virtualization-nav *@
@* Ctrl+Arrow Up / Down keyboard navigation with virtualization *@
@* Reuses existing ScrollIntoViewAsync public API; constraint guards: virtualization off, grouped, infinite scroll. *@


@* Fixture 1: Happy path - virtualization on, no grouping, no infinite scroll *@
<SfFixture @ref="fixture1" Test="CtrlArrow_VirtualizedGrid_NavigatesToFirstLastRow" Description="[OPSX-20261016-ctrl-arrow-virtualization-nav] Ctrl+Arrow Up/Down navigate to first/last row in virtualized grid">
    <ComponentUnderTest>
        <SfGrid @ref="Grid1" DataSource="GenerateVirtualData()" Height="400" Width="800" EnableVirtualization="true" RowHeight="38">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" IsPrimaryKey="true" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" Width="130" HeaderText="Order Date"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="100" HeaderText="Freight" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture1 { get; set; }
    private SfGrid<Order> Grid1;

    void CtrlArrow_VirtualizedGrid_NavigatesToFirstLastRow(Fixture fixture1)
    {
        var cut = fixture1.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.EnableVirtualization, "REQ-KBN-CAP-01: virtualization is enabled");

        var totalRows = cut.Instance.TotalItemCount;
        Assert.True(totalRows > 1, "REQ-KBN-CAP-01: grid has multiple rows");

        // Click on a cell in the visible rows to focus it
        var cells = cut.FindAll(".e-rowcell");
        if (cells.Count > 0)
        {
            cells[0].Click(new MouseEventArgs { Type = "click" });
        }

        // Simulate Ctrl+Arrow Down keyboard event on focused cell
        // The ProcessKeyDown method should be called by the cell's onkeydown handler
        var keyboardEvent = new KeyboardEventArgs
        {
            Key = "ArrowDown",
            Code = "ArrowDown",
            CtrlKey = true,
            ShiftKey = false,
            AltKey = false,
            MetaKey = false,
        };

        if (cut.Instance.Rows?.Count > 0)
        {
            var firstCell = cut.Instance.Rows[0]?.Cells?.FirstOrDefault();
            if (firstCell != null)
            {
                cut.InvokeAsync(async () => 
                    await cut.Instance.FocusModule.ProcessKeyDown(keyboardEvent, cut.Instance.Rows[0], firstCell)
                ).Wait();

                // After ProcessKeyDown, CurrentRowIndex should be set to the last row
                Assert.Equal(totalRows - 1, cut.Instance.VirtualScrollModule.CurrentRowIndex);
            }
        }

        // Simulate Ctrl+Arrow Up keyboard event
        keyboardEvent = new KeyboardEventArgs
        {
            Key = "ArrowUp",
            Code = "ArrowUp",
            CtrlKey = true,
            ShiftKey = false,
            AltKey = false,
            MetaKey = false,
        };

        if (cut.Instance.Rows?.Count > 0)
        {
            var firstCell = cut.Instance.Rows[0]?.Cells?.FirstOrDefault();
            if (firstCell != null)
            {
                cut.InvokeAsync(async () => 
                    await cut.Instance.FocusModule.ProcessKeyDown(keyboardEvent, cut.Instance.Rows[0], firstCell)
                ).Wait();

                // After ProcessKeyDown, CurrentRowIndex should be set to the first row
                Assert.Equal(0, cut.Instance.VirtualScrollModule.CurrentRowIndex);
            }
        }
    }

    public List<Order> GenerateVirtualData()
    {
        return Enumerable.Range(1, 200).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = "ALFKI" + x,
            Freight = 25.7 + x,
            OrderDate = new DateTime(2010, 5, 1).AddDays(x),
        }).ToList();
    }
}


