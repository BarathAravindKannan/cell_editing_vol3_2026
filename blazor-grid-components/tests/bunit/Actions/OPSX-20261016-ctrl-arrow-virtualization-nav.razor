            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" IsPrimaryKey="true" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture5 { get; set; }
    private SfGrid<Order> Grid5;

    void CtrlArrow_SingleRowGrid_NoCrash(Fixture fixture5)
    {
        var cut = fixture5.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.EnableVirtualization, "REQ-KBN-CAP-01: virtualization enabled");
        Assert.Equal(1, cut.Instance.TotalItemCount);

        var keyboardEvent = new KeyboardEventArgs
        {
            Key = "ArrowDown",
            Code = "ArrowDown",
            CtrlKey = true,
            ShiftKey = false,
            AltKey = false,
            MetaKey = false,
        };

        if (cut.Instance.Rows?.Count > 0)
        {
            var firstCell = cut.Instance.Rows[0]?.Cells?.FirstOrDefault();
            if (firstCell != null)
            {
                cut.InvokeAsync(async () => 
                    await cut.Instance.FocusModule.ProcessKeyDown(keyboardEvent, cut.Instance.Rows[0], firstCell)
                ).Wait();

                // Should not throw - guard sets CurrentRowIndex = 0 (TotalItemCount-1 = 0)
