@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Grids.Internal
@using System.Reflection

<SfFixture @ref="fixture" Test="FilterMenuToggleTest" Description="Toggle filter dialog on Menu filter type">
    <ComponentUnderTest>
        <SfGrid @ref="GridMenuFilter" DataSource="GenerateOrderData()" AllowFiltering="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="OrderID" Width="150"></GridColumn>
                <GridColumn Field="CustomerID" Width="150"></GridColumn>
                <GridColumn Field="Freight" Width="150" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    private SfGrid<Order> GridMenuFilter;

    async void FilterMenuToggleTest(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        // WHEN: User clicks filter icon on a column
        var filterIcons = cut.FindAll(".e-filtericon");
        Assert.True(filterIcons.Count > 0, "Filter icons should exist");
        var filterIcon = filterIcons[0];
        
        // Click to open dialog
        await filterIcon.TriggerEventAsync("onclick", new());
        cut.WaitForState(() => GetFilterIconIsClicked(grid), TimeSpan.FromSeconds(5));
        
        // THEN: Dialog opens and state tracks the column as open
        Assert.True(GetFilterIconIsClicked(grid), "Dialog should be marked as clicked");
        var headerCells = cut.FindAll(".e-headercell");
        Assert.True(headerCells.Count > 1, "Header cells should exist");
        string columnUid = headerCells[1].GetAttribute("data-uid");
        Assert.True(IsFilterDialogOpen(grid, columnUid), "Column dialog state should be tracked as open");
        
        // WHEN: User clicks the same filter icon again  
        filterIcons = cut.FindAll(".e-filtericon");
        filterIcon = filterIcons[0];
        await filterIcon.TriggerEventAsync("onclick", new());
        cut.WaitForState(() => !GetFilterIconIsClicked(grid), TimeSpan.FromSeconds(5));
        
        // THEN: Dialog closes and state is reset
        Assert.False(GetFilterIconIsClicked(grid), "Dialog should be marked as not clicked after toggle");
        Assert.False(IsFilterDialogOpen(grid, columnUid), "Column dialog state should be reset");
        Assert.Null(GetOpenFilterColumnUid(grid));
    }
}

