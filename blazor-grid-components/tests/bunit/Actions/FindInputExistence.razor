    public async Task FindActiveHighlightMatchesSelectedRow(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetailsFH>>();
        Assert.NotNull(cut);

        await cut.InvokeAsync(() => cut.Instance.FindHighlightAsync("Nancy"));
        await cut.InvokeAsync(() => cut.Instance.FindNextHighlightAsync());

        var activeRow = cut.FindAll("tr.e-row")
            .Single(row => row.QuerySelectorAll("mark.e-find-highlight-active").Length == 1);
        var activeRowIndex = activeRow.GetAttribute("aria-rowindex");
        Assert.True(int.TryParse(activeRowIndex, out var ariaRowIndex),
            "The active highlight row should expose a numeric data-rowindex.");
        var selectedRowIndex = ariaRowIndex - 1;

        await cut.InvokeAsync(() => cut.Instance.SelectRowAsync(selectedRowIndex));
        cut.WaitForState(() => cut.FindAll(".e-selectionbackground").Count > 0);

        var selectedRows = cut.FindAll("tr.e-row")
            .Where(row => row.QuerySelectorAll(".e-selectionbackground").Length > 0)
            .ToList();
        Assert.True(selectedRows.Count == 1, "Exactly one row should be selected.");
        Assert.True(selectedRows[0].GetAttribute("aria-rowindex") == activeRowIndex,
            "The selected row should be the row containing the active orange highlight.");
        Assert.True(selectedRows[0].QuerySelectorAll("mark.e-find-highlight-active").Length == 1,
            "The selected row should contain the active orange highlight.");

        await cut.InvokeAsync(() => cut.Instance.ClearSelectionAsync());

        var activeRowAfterDeselect = cut.FindAll("tr.e-row")
            .Single(row => row.QuerySelectorAll("mark.e-find-highlight-active").Length == 1);
        Assert.True(activeRowAfterDeselect.GetAttribute("aria-rowindex") == activeRowIndex,
            "The active orange highlight should remain on the same row after deselection.");
        Assert.True(cut.FindAll(".e-selectionbackground").Count == 0,
            "The row should no longer be selected after deselection.");
    }

