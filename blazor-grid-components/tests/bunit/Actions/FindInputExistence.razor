    void GetCellValueCoverage(Fixture fixture)
    {
        // Use reflection to invoke the private static GetCellValue method on FindHighlight<T>
        var genericType = Type.GetType("Syncfusion.Blazor.Grids.Internal.FindHighlight`1");
        // Fallback: locate by assembly-qualified name
        if (genericType == null)
        {
            // try to find the type in the current AppDomain
            genericType = AppDomain.CurrentDomain.GetAssemblies()
                            .SelectMany(a => { try { return a.GetTypes(); } catch { return Array.Empty<Type>(); } })
                .FirstOrDefault(t => t.IsGenericType && t.Name == "FindHighlight`1");
        }

        Assert.NotNull(genericType);
        var constructed = genericType.MakeGenericType(typeof(EmployeeDetailsFH));
        var method = constructed.GetMethod("GetCellValue", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
        Assert.NotNull(method);

        object? Invoke(object? row, string field) => method.Invoke(null, new object[] { row, field });

        // 1) Null row or null/empty field -> null
        Assert.Null(Invoke(null, "FirstName"));
        Assert.Null(Invoke(new EmployeeDetailsFH(), string.Empty));

        // 2) ExpandoObject (IDictionary<string, object?>)
        dynamic exp = new System.Dynamic.ExpandoObject();
        var edict = (System.Collections.Generic.IDictionary<string, object?>)exp;
        edict["FirstName"] = "ExpandoNancy";
        var val = Invoke(exp, "FirstName");
        Assert.Equal("ExpandoNancy", val);

        // 3) Non-generic IDictionary (Hashtable)
        var ht = new System.Collections.Hashtable();
        ht["Email"] = "ht@example.com";
        var htVal = Invoke(ht, "Email");
        Assert.Equal("ht@example.com", htVal);

        // 4) DynamicObject (IDynamicMetaObjectProvider) - create a custom dynamic object
        var dyn = new CustomDynamic();
        var dynVal = Invoke(dyn, "DynamicProp");
        Assert.Equal("dynamic-value", dynVal);

        // 5) CLR object with nested property access
        var outer = new Outer { Inner = new Inner { Name = "InnerName" } };
        var nestedVal = Invoke(outer, "Inner.Name");
        Assert.Equal("InnerName", nestedVal);

        // 6) CLR object missing property -> null
        var simple = new EmployeeDetailsFH { FirstName = "X" };
        Assert.Null(Invoke(simple, "NonExisting"));
    }

