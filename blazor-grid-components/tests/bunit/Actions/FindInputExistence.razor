    private SfGrid<EmployeeDetailsFH> GridWithFind;
    private SfGrid<EmployeeDetailsFH> GridWithoutFind;
    private SfGrid<EmployeeDetailsFH> GridForHighlight;
    private SfGrid<EmployeeDetailsFH> GridForKeyNav;
    private SfGrid<EmployeeDetailsFH> GridVirtual;
    private SfGrid<EmployeeDetailsFH> GridAllowSearchFalse;
    private SfGrid<dynamic> GridForDynamic;
    private SfGrid<OrderDetails> GridFk;
    private SfGrid<EmployeeDetailsFH> GridForFindSettings;
    private SfGrid<EmployeeDetailsFH> GridVirtualCol;
    private SfGrid<EmployeeDetailsFH> GridCrud;
