        // After notification, the FindHighlight module should have computed TotalMatchesBeforeViewport (non-negative)
        Assert.True(cut.Instance.FindHightLightModule.TotalMatchesBeforeViewport >= 0, "TotalMatchesBeforeViewport should be computed and non-negative");

        // Exercise GetColumnIndexForGlobalMatchIndexAsync directly
        var colIndex = await cut.Instance.FindHightLightModule.GetColumnIndexForGlobalMatchIndexAsync(1);
        Assert.True(colIndex >= -1, "GetColumnIndexForGlobalMatchIndexAsync should return an index (or -1)");

        // Exercise CalculateTotalMatchesBeforeColumnAsync directly
        var calc = await cut.Instance.FindHightLightModule.CalculateTotalMatchesBeforeColumnAsync(0, 0);
        Assert.True(calc >= 0, "CalculateTotalMatchesBeforeColumnAsync should return a non-negative count");
    }

