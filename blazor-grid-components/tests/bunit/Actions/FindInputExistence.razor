    // Fixture: Apply highlight then filter and sort, check find counter updates


    public SfFixture fixtureFilterSort { get; set; }
    private SfGrid<EmployeeDetailsFH> GridFilterSort;
    // Dynamic data initialized in constructor so it's available at render time
    private List<dynamic> DynamicOrders;

    // Foreign-key sample data (Orders + Employees)
    public List<OrderDetails> Orders { get; set; }
    public List<EmployeeDetails> Employees { get; set; }

    public FindInputExistence()
    {
        DynamicOrders = new List<dynamic>();
        for (int i = 1; i <= 5; i++)
        {
            dynamic d = new System.Dynamic.ExpandoObject();
            var dict = (System.Collections.Generic.IDictionary<string, object>)d;
            dict["OrderID"] = 3000 + i;
            dict["CustomerID"] = i % 2 == 0 ? "ALFKI" : "BOLID";
            dict["ShipCountry"] = i % 3 == 0 ? "USA" : "UK";
            dict["Freight"] = Math.Round(2.5 * i, 2);
            DynamicOrders.Add(d);
        }

        // initialize FK sample data
        Orders = OrderDetails.GetAllRecords();
        Employees = EmployeeDetails.GetAllRecords();
    }

    void FindInputRendered(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetailsFH>>();
        Assert.True(cut.FindAll(".e-find-input").Count == 1, "Find input should render when the Find toolbar item is enabled");
        Assert.True(cut.FindAll(".e-find-counter").Count == 1, "Find counter should render with the input");
        Assert.True(cut.FindAll(".e-find-nav-btn").Count == 2, "Find navigation buttons should render with the input");
        Assert.True(cut.FindAll(".e-find-input")[0].GetAttribute("placeholder") == "Find", "Find input placeholder should default to 'Find' ");
        Assert.True(cut.Find(".e-find-counter").TextContent.Trim() == "0/0", "Find counter should start at 0/0 before a search");
        Assert.True(cut.Find(".e-find-counter").GetAttribute("title") == "No Matches Found", "Find counter should not expose stale match totals before a search");
        var input = cut.Find(".e-find-input");
        Assert.True(input.GetAttribute("role") == "searchbox", "Find input should expose the searchbox role");
        Assert.True(!string.IsNullOrEmpty(input.GetAttribute("aria-label")), "Find input should have an accessible name");
        Assert.True(!string.IsNullOrEmpty(input.GetAttribute("aria-describedby")), "Find input should reference the live status");
        Assert.True(!string.IsNullOrEmpty(cut.Find(".e-find-next-btn").GetAttribute("aria-label")), "Next button should have an accessible name");
        Assert.True(!string.IsNullOrEmpty(cut.Find(".e-find-prev-btn").GetAttribute("aria-label")), "Previous button should have an accessible name");
        Assert.True(!string.IsNullOrEmpty(cut.Find(".e-find-clear-btn").GetAttribute("aria-label")), "Clear button should have an accessible name");
    }

    void FindInputNotRendered(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetailsFH>>();
        Assert.True(cut.FindAll(".e-find-input").Count == 0, "Find input should not render when the Find toolbar item is not provided");
        // Also ensure counter and nav buttons are not present
        Assert.True(cut.FindAll(".e-find-counter").Count == 0, "Find counter should not render when Find is absent");
        Assert.True(cut.FindAll(".e-find-nav-btn").Count == 0, "Find navigation buttons should not render when Find is absent");
    }

    void FindInputHighlighting(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetailsFH>>();
        // ensure input exists
        var inputs = cut.FindAll(".e-find-input");
        Assert.True(inputs.Count == 1, "Find input must be present to perform highlight test");

        // simulate entering text in the input (this updates DOM element value)
        var input = inputs[0];
        // use Input() because the element wires 'oninput' handler (Change() triggers 'onchange')
        input.Input("Archi");

        // call the grid's FindHighlightAsync to trigger server-side highlighting logic
        var gridInstance = cut.Instance;
        gridInstance.FindHighlightAsync("Archi").GetAwaiter().GetResult();

        // re-query for highlighted marks
        var marks = cut.FindAll("mark.e-find-highlight");
        Assert.True(marks.Count >= 1, "Expected at least one highlighted match after FindHighlightAsync");
        Assert.Contains("Archi", marks[0].TextContent, System.StringComparison.OrdinalIgnoreCase);

        // check the find counter displays the correct total matches (format: "current/total")
        var counters = cut.FindAll(".e-find-counter span");
        Assert.True(counters.Count >= 1, "Find counter element should be present");
        var counterText = counters[0].TextContent?.Trim() ?? string.Empty;
        var parts = counterText.Split('/');
        Assert.True(parts.Length == 2, $"Unexpected find counter format: '{counterText}'");
