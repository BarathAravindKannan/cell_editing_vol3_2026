    public async Task ColumnShowHideUpdatesFindCounter(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetailsFH>>();
        Assert.NotNull(cut);

        // perform initial search for 'Margaret'
        var inputs = cut.FindAll(".e-find-input");
        Assert.True(inputs.Count == 1, "Find input must be present");
        var input = inputs[0];
        input.Input("Margaret");
        await cut.InvokeAsync(() => cut.Instance.FindHighlightAsync("Margaret"));
        cut.Render();

        // capture total before hiding column
        var counterSpans = cut.FindAll(".e-find-counter span");
        var counterText = counterSpans.Count > 0 ? counterSpans[0].TextContent?.Trim() ?? "0/0" : "0/0";
        var parts = counterText.Split('/');
        int totalBefore = 0;
        if (parts.Length == 2) int.TryParse(parts[1], out totalBefore);

        var marks = cut.FindAll("mark.e-find-highlight");
        Assert.True(totalBefore == marks.Count, $"Initial counter total ({totalBefore}) should equal marks count ({marks.Count})");

        // Hide the Email column
        var emailCol = cut.Instance.Columns?.FirstOrDefault(c => string.Equals(c.Field, nameof(EmployeeDetailsFH.Email), StringComparison.OrdinalIgnoreCase) || string.Equals(c.HeaderText, "Email", StringComparison.OrdinalIgnoreCase));
        Assert.NotNull(emailCol);
        await cut.InvokeAsync(() => cut.Instance.HideColumnAsync("Email"));
        cut.Render();

        var counterSpansAfterHide = cut.FindAll(".e-find-counter span");
        var counterTextAfterHide = counterSpansAfterHide.Count > 0 ? counterSpansAfterHide[0].TextContent?.Trim() ?? "0/0" : "0/0";
        var partsAfterHide = counterTextAfterHide.Split('/');
        int totalAfterHide = 0;
        if (partsAfterHide.Length == 2) int.TryParse(partsAfterHide[1], out totalAfterHide);

        var marksAfterHide = cut.FindAll("mark.e-find-highlight");
        Assert.True(totalAfterHide == marksAfterHide.Count, $"After hiding Email column, counter total ({totalAfterHide}) should equal marks count ({marksAfterHide.Count})");
        Assert.True(totalAfterHide <= totalBefore, "Total matches after hiding a column should be less than or equal to total before");

        // Show the Email column again
        await cut.InvokeAsync(() =>  cut.Instance.ShowColumnAsync("Email"));
        cut.Render();

        var counterSpansAfterShow = cut.FindAll(".e-find-counter span");
        var counterTextAfterShow = counterSpansAfterShow.Count > 0 ? counterSpansAfterShow[0].TextContent?.Trim() ?? "0/0" : "0/0";
        var partsAfterShow = counterTextAfterShow.Split('/');
        int totalAfterShow = 0;
        if (partsAfterShow.Length == 2) int.TryParse(partsAfterShow[1], out totalAfterShow);

        var marksAfterShow = cut.FindAll("mark.e-find-highlight");
        Assert.True(totalAfterShow == marksAfterShow.Count, $"After showing Email column, counter total ({totalAfterShow}) should equal marks count ({marksAfterShow.Count})");
        Assert.True(totalAfterShow >= totalAfterHide, "Total matches after showing the column should be greater than or equal to after hiding it");
        cut.Instance.FindNextHighlightAsync();
        cut.Instance.FindPreviousHighlightAsync();
    }

