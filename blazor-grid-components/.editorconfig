# Harness-generated .editorconfig — Roslyn/.NET conventions that the
# analyzers gate (dotnet build /p:EnforceCodeStyleInBuild) enforces on the
# ratchet: new violations fail, the legacy 210-warning floor is frozen.
root = true

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

# Defect-relevant rules (tied to catalog ids):
# BZ-205: never write back to [Parameter]
dotnet_diagnostic.CA2214.severity = suggestion
# BZ-201/CA2000: disposal discipline for interop references
dotnet_diagnostic.CA2000.severity = warning
# async void outside handlers crashes servers (BZ-203 family)
dotnet_diagnostic.CA1843.severity = suggestion
# catch swallow (banner-suppression adjacent, BZ-406)
dotnet_diagnostic.CA1031.severity = suggestion

[*.{razor,cshtml,ts,js,json,yaml,yml,md}]
charset = utf-8
insert_final_newline = true

[*.{ts,js}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = true
