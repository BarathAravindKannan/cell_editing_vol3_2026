@page "/"
@using Syncfusion.Blazor.Grids
@using System.Diagnostics

<h3>Syncfusion Grid Dom Virtualization 1 million records</h3>

<div style="margin-bottom:10px">
    <p>Data Generation Time: <b>@DataGenerationMs ms</b></p>
    <p>Grid First Render Time: <b>@GridRenderMs ms</b></p>
    <p>Total Time: <b>@TotalMs ms</b></p>
</div>

<SfGrid DataSource="@Orders"
        Height="300"
        EnableDomVirtualization="true"
        RowHeight="30">

    <GridEvents DataBound="OnDataBound" TValue="Order"></GridEvents>

    <GridColumns>
        <GridColumn Field=@nameof(Order.OrderId)
                    HeaderText="Order ID"
                    Width="120">
        </GridColumn>

        <GridColumn Field=@nameof(Order.CustomerName)
                    HeaderText="Customer"
                    Width="200">
        </GridColumn>

        <GridColumn Field=@nameof(Order.Country)
                    HeaderText="Country"
                    Width="150">
        </GridColumn>

        <GridColumn Field=@nameof(Order.Amount)
                    HeaderText="Amount"
                    Format="C2"
                    Width="150">
        </GridColumn>
    </GridColumns>

</SfGrid>

@code
{
    private List<Order> Orders = new();

    private readonly Stopwatch TotalStopwatch = new();

    public long DataGenerationMs { get; set; }
    public long GridRenderMs { get; set; }
    public long TotalMs { get; set; }

    protected override void OnInitialized()
    {
        TotalStopwatch.Start();

        var dataWatch = Stopwatch.StartNew();

        Orders = Enumerable.Range(1, 1_000_000)
            .Select(i => new Order
            {
                OrderId = i,
                CustomerName = $"Customer {i}",
                Country = $"Country {i % 50}",
                Amount = i * 10
            })
            .ToList();

        dataWatch.Stop();

        DataGenerationMs = dataWatch.ElapsedMilliseconds;
    }

    private void OnDataBound()
    {
        // Fired when initial data binding/render completes
        if (GridRenderMs == 0)
        {
            TotalStopwatch.Stop();

            TotalMs = TotalStopwatch.ElapsedMilliseconds;
            GridRenderMs = TotalMs - DataGenerationMs;

            StateHasChanged();
        }
    }

    public class Order
    {
        public int OrderId { get; set; }
        public string CustomerName { get; set; } = "";
        public string Country { get; set; } = "";
        public decimal Amount { get; set; }
    }
}